<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lusicians valheim panel</title>
    <link rel="stylesheet" href="/style.css" />
    <script src="/app.js" defer></script>
  </head>
  <body>
    <main>
      <header><h1>Valheim panel</h1></header>
      <section class="server-status">
        <p>Server status:</p>
        <p id="status" class="badge <%= status %>"><%= status %></p>
      </section>
      <section class="control-buttons">
        <ul class="flex-list">
          <li><button id="startSrv" class="btn start">Start server</button></li>
          <li><button id="stopSrv" class="btn stop">Stop server</button></li>
        </ul>
      </section>
    </main>
  </body>
</html>
