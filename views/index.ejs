<header class="topbar">
  <div class="brand">
    <div class="brand-mark">V</div>
    <div>
      <p class="brand-name"><%= panelName %></p>
      <p class="brand-sub">Server control panel</p>
    </div>
  </div>
  <form method="post" action="/logout">
    <button class="btn btn-ghost">Log out</button>
  </form>
</header>

<main class="content">
  <section class="card hero">
    <div class="hero-status">
      <p class="eyebrow">Server status</p>
      <p id="status" class="badge badge-lg <%= status %>"><%= status %></p>
      <p class="meta">
        Last checked
        <b id="checkedAt"><%= new Date(checkedAt).toLocaleTimeString('nb-NO', { timeZone: 'Europe/Oslo' }) %></b>
      </p>
    </div>
    <ul class="controls">
      <li><button id="startSrv" class="btn btn-start">Start</button></li>
      <li><button id="stopSrv" class="btn btn-stop">Stop</button></li>
      <li><button id="restartSrv" class="btn btn-secondary">Restart</button></li>
      <li><button id="updateSrv" class="btn btn-secondary">Update</button></li>
    </ul>
  </section>
  <section id="updateCard" class="card" hidden>
    <div class="card-head">
      <h2 class="card-title">Update output</h2>
      <span id="updateState" class="pill">Running</span>
    </div>
    <pre id="updateLog" class="log-box"></pre>
  </section>
</main>