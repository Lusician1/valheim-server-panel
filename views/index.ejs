<header class="topbar">
  <div class="brand">
    <div class="brand-mark">V</div>
    <div>
      <p class="brand-name"><%= panelName %></p>
      <p class="brand-sub">Server control panel</p>
    </div>
  </div>
  <form method="post" action="/logout">
    <button class="btn btn-ghost">Log out</button>
  </form>
</header>

<main class="content">
  <section class="card hero">
    <div class="hero-status">
      <p class="card-title">Server status</p>
      <p id="status" class="badge badge-lg <%= status %>"><%= status %></p>
      <p class="meta">
        Last checked:
        <b id="checkedAt"
          ><%= new Date(checkedAt).toLocaleTimeString('nb-NO', { timeZone:
          'Europe/Oslo' }) %></b
        >
      </p>
    </div>
    <ul class="controls">
      <li><button id="startSrv" class="btn btn-start">Start</button></li>
      <li><button id="stopSrv" class="btn btn-stop">Stop</button></li>
      <li>
        <button id="restartSrv" class="btn btn-secondary">Restart</button>
      </li>
      <li><button id="updateSrv" class="btn btn-secondary">Update</button></li>
      <li><button id="backupSrv" class="btn btn-secondary">Backup</button></li>
    </ul>
  </section>

  <section class="stats">
    <!-- Players -->
    <div class="card">
      <h2 class="card-title">Players</h2>
      <p class="stat-value"><span id="playerCount">0</span> online</p>
      <p class="stat-sub">Seen this session</p>
      <ul id="playerList" class="player-list"></ul>
    </div>
    <!-- CPU -->
    <div class="card">
      <h2 class="card-title">CPU</h2>
      <p class="stat-value"><span id="cpuValue"><%= system.cpu %></span>%</p>
      <div class="bar">
        <div
          id="cpuBar"
          class="bar-fill"
          style="width: <%= system.cpu %>%"
        ></div>
      </div>
    </div>
    <!-- Memory -->
    <div class="card">
      <h2 class="card-title">Memory</h2>
      <p class="stat-value">
        <span id="memoryValue"><%= system.memory.used %></span>GB
      </p>
      <div class="bar">
        <div
          id="memoryBar"
          class="bar-fill"
          style="width: <%= system.memory.percent %>%"
        ></div>
      </div>
      <p class="stat-sub">of <%= system.memory.total %>GB</p>
    </div>
    <!-- Disk -->
    <div class="card">
      <h2 class="card-title">Disk</h2>
      <p class="stat-value">
        <span id="diskValue"><%= system.disk.used %></span>GB
      </p>
      <div class="bar">
        <div
          id="diskBar"
          class="bar-fill"
          style="width: <%= system.disk.percent %>%"
        ></div>
      </div>
      <p class="stat-sub">of <%= system.disk.total %> GB</p>
    </div>
  </section>
  <!-- Chat. save for later when adding chat monitor -->
  <!-- <section class="card chat-card">
    <h2 class="card-title">Server Chat</h2>
    <form id="msgForm" class="msg-form">
      <p id="chatError" class="chat-error"></p>
      <input
        required
        class="input chat-input"
        id="msgInput"
        type="text"
        maxlength="200"
        aria-label="Type your message here"
        placeholder="Type your message here..."
        autocomplete="off"
      />
      <button id="sendMsg" class="btn btn-secondary">Send</button>
    </form>
  </section> -->
  <!-- Log -->
  <section class="card">
    <h2 class="card-title">Server log</h2>
    <ul id="serverLog" class="log-box"></ul>
    <!-- Temporary neater chat box until adding chat monitor -->
    <form id="msgForm" class="msg-form">
      <p id="chatError" class="chat-error"></p>
      <input
        required
        class="input chat-input"
        id="msgInput"
        type="text"
        maxlength="200"
        aria-label="Type your message here"
        placeholder="Type your message here..."
        autocomplete="off"
      />
      <button id="sendMsg" class="btn btn-secondary">Send</button>
    </form>
  </section>
  <!-- Update -->
  <section id="jobCard" class="card" hidden>
    <div class="card-head">
      <h2 id="jobTitle" class="card-title">Job output</h2>
      <span id="jobState" class="pill">Running</span>
    </div>
    <pre id="jobLog" class="log-box"></pre>
  </section>
</main>
