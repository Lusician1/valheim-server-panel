<header class="topbar">
  <div class="brand">
    <div class="brand-mark">V</div>
    <div>
      <p class="brand-name"><%= panelName %></p>
      <p class="brand-sub">Server control panel</p>
    </div>
  </div>
  <form method="post" action="/logout">
    <button class="btn btn-ghost">Log out</button>
  </form>
</header>

<main class="content">
  <section class="card hero">
    <div class="hero-status">
      <p class="eyebrow">Server status</p>
      <p id="status" class="badge badge-lg <%= status %>"><%= status %></p>
      <p class="meta">
        Last checked
        <b id="checkedAt"
          ><%= new Date(checkedAt).toLocaleTimeString('nb-NO', { timeZone:
          'Europe/Oslo' }) %></b
        >
      </p>
    </div>
    <ul class="controls">
      <li><button id="startSrv" class="btn btn-start">Start</button></li>
      <li><button id="stopSrv" class="btn btn-stop">Stop</button></li>
      <li>
        <button id="restartSrv" class="btn btn-secondary">Restart</button>
      </li>
      <li><button id="updateSrv" class="btn btn-secondary">Update</button></li>
    </ul>
  </section>

  <section class="stats">
    <div class="card">
      <!-- CPU -->
      <h2 class="card-title">CPU</h2>
      <p class="stat-value"><span id="cpuValue"><%= system.cpu %></span>%</p>
      <div class="bar">
        <div
          id="cpuBar"
          class="bar-fill"
          style="width: <%= system.cpu %>%"
        ></div>
        <!-- Memory -->
      </div>
      <h2 class="card-title">Memory</h2>
      <p class="stat-value">
        <span id="memoryValue"><%= system.memory.used %></span>GB
      </p>
      <p class="stat-sub">of <%= system.memory.total %>GB</p>
      <div class="bar">
        <div
          id="memoryBar"
          class="bar-fill"
          style="width: <%= system.memory.percent %>%"
        ></div>
        <!-- Disk -->
      </div>
      <h2 class="card-title">Disk</h2>
      <p class="stat-value">
        <span id="diskValue"><%= system.disk.used %></span>GB
      </p>
      <p class="stat-sub">of <%= system.disk.total %> GB</p>
      <div class="bar">
        <div
          id="diskBar"
          class="bar-fill"
          style="width: <%= system.disk.percent %>%"
        ></div>
      </div>
    </div>
  </section>
  <!-- Log -->
  <section class="card">
    <h2 class="card-title">Server log</h2>
    <ul id="serverLog" class="log-box"></ul>
  </section>
  <!-- Update -->
  <section id="updateCard" class="card" hidden>
    <div class="card-head">
      <h2 class="card-title">Update output</h2>
      <span id="updateState" class="pill">Running</span>
    </div>
    <pre id="updateLog" class="log-box"></pre>
  </section>
</main>
